# Copy to infra/.env and replace every secret. Never commit .env.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
# Production defaults to prod; only use dev for local simulations.
SPRING_PROFILES_ACTIVE=dev

# API OpenAI : à définir uniquement sur votre poste / serveur, jamais dans Git
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Tarifs du modèle sélectionné, en USD / million de tokens. Renseigner les prix officiels.
# Sans tarifs renseignés, les appels IA sont bloqués pour éviter une facturation non suivie.
OPENAI_PRICE_INPUT_USD_PER_MILLION=0
OPENAI_PRICE_OUTPUT_USD_PER_MILLION=0
